HOST=127.0.0.1
PORT=4317
# Optional absolute paths; defaults are project-local.
# DATA_DIR=
# YTDLP_PATH=
# FFMPEG_PATH=
# FFPROBE_PATH=
# Optional pinned official yt-dlp release tag for npm run setup.
# YTDLP_VERSION=
# Local speech model; no API key required.
# WHISPER_MODEL=onnx-community/whisper-base_timestamped
# Keep model weights on local storage (default: ~/.cache/soundcloud-vid-gen/models).
# MODEL_CACHE_DIR=
# Optional browser/workflow verification target.
# APP_URL=http://127.0.0.1:4317
# TikTok developer app (Login Kit desktop + Content Posting API, video.upload scope).
# Register redirect URI http://127.0.0.1:4317/api/tiktok/callback/
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
