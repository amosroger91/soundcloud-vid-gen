{
  "name": "soundcloud-vid-gen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SoundCloud links to audio-reactive portrait videos.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node server/index.mjs --dev",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:render": "node scripts/smoke-render.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "setup:speech": "node scripts/setup-speech.mjs",
    "logo": "node scripts/logo.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@napi-rs/canvas": "^1.0.10",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fft.js": "^4.0.4",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.0",
    "supertest": "^7.3.1",
    "vite": "^8.3.4"
  }
}
